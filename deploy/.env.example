# /opt/car-tracker/.env on the server (chmod 600). Never commit the real one.

# Public address of the app (used in invite links).
PUBLIC_URL=https://cars.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel: the token from the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# OpenAI key for bill import + fuel scans (ideally its own project with a budget limit).
# Empty → no AI; everything can still be entered by hand.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-5-mini
# AI_MONTHLY_LIMIT_PER_USER=60
# AI_MONTHLY_FUEL_SCANS_PER_USER=100

# Installed release. Managed by ./update.sh, don't edit by hand.
APP_VERSION=
